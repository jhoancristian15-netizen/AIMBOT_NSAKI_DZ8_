local ABILITY_WORDS = {"skill", "ability", "cast", "spell", "use", "attack", "dash", "blink", "punch", "throw", "heal", "summon", "ultimate"}
local AMMO_WORDS = {"ammo", "ammunition", "balas", "municion", "mag", "clip", "rounds", "bullets", "charges", "cargas", "bulletsleft"}

local function matchWords(name, words)
    local n = string.lower(name)
    for _, w in ipairs(words) do if string.find(n, w, 1, true) then return true end end
    return false
end

local function fillAmmo()
    local roots = { player.PlayerGui, player.Backpack, player.Character }
    for _, r in ipairs(roots) do
        if r then
            for _, obj in ipairs(r:GetDescendants()) do
                if obj:IsA("ValueBase") and matchWords(obj.Name, AMMO_WORDS) then
                    if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                        if obj.Value < C.AMMO_VALUE - 50 then obj.Value = C.AMMO_VALUE end
                    elseif obj:IsA("StringValue") then
                        local num = tonumber(obj.Value)
                        if num and num < C.AMMO_VALUE - 50 then obj.Value = tostring(C.AMMO_VALUE) end
                    end
                end
            end
        end
    end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if tool then
        for attr, val in pairs(tool:GetAttributes()) do
            if type(val) == "number" and matchWords(attr, AMMO_WORDS) and val < C.AMMO_VALUE - 50 then
                pcall(function() tool:SetAttribute(attr, C.AMMO_VALUE) end)
            end
        end
    end
end
task.spawn(function()
    while true do if C.InfiniteAmmo then pcall(fillAmmo); task.wait(0.25) else task.wait(0.2) end end
end)

