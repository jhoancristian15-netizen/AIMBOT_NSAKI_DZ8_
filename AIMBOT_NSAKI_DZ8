-- Busca NPCs / dummies (modelos con Humanoid que no sean jugadores)
local function scanNPCs()
        local found = {}

        local function scan(container, depth)
                if depth > 2 then return end
                for _, obj in ipairs(container:GetChildren()) do
                        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                                if not Players:GetPlayerFromCharacter(obj) and obj ~= player.Character then
                                        local hum = obj:FindFirstChildOfClass("Humanoid")
                                        if hum and hum.Health > 0 then
                                                table.insert(found, obj)
                                        end
                                end
                        elseif obj:IsA("Folder") or obj:IsA("Model") then
                                scan(obj, depth + 1)
                        end
                end
        end

        scan(workspace, 0)
        return found
end

local function collectTargets()
        local targets = {}

        for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if hum and hrp and hum.Health > 0 then
                                table.insert(targets, plr.Character)
                        end
                end
        end

        if BringNPCs then
                for _, npc in ipairs(scanNPCs()) do
                        if npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart") then
                                table.insert(targets, npc)
                        end
                end
        end

        return targets
end

