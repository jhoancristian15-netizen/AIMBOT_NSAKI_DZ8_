local function params(ft, list)
    local p = RaycastParams.new()
    p.FilterType = ft; p.FilterDescendantsInstances = list; p.IgnoreWater = true
    return p
end

local function wallbangCast(origin, direction)
    if direction.Magnitude < 0.1 then return nil end
    local unit = direction.Unit
    local chars = charCache
    if #chars == 0 then return nil end
    local hit = workspace:Raycast(origin, direction, params(INCLUDE, chars))
    if not hit or not hit.Instance then return nil end
    local travel = (hit.Position - origin).Magnitude
    if travel <= 0.1 then return hit end
    local world = params(EXCLUDE, chars)
    local cursor, used = origin, 0
    for _ = 1, C.MAX_WALLS do
        local rem = travel - used
        if rem <= 0.05 then break end
        local wall = workspace:Raycast(cursor, unit * rem, world)
        if not wall then break end
        local probeList = table.clone(chars)
        table.insert(probeList, wall.Instance)
        local probe = workspace:Raycast(wall.Position + unit * 0.02, unit * (C.MAX_WALL + 1), params(EXCLUDE, probeList))
        if not probe or (probe.Position - wall.Position).Magnitude > C.MAX_WALL then return nil end
        cursor = probe.Position + unit * 0.02
        used = (cursor - origin).Magnitude
    end
    return hit
end

local guard, original, lastWallbang, lastRemote = false, nil, 0, {}
local function install()
    if original or not hookmetamethod then return end
    local ok, fn = pcall(hookmetamethod, game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if C.NoCooldown and method == "FireServer" and typeof(self) == "Instance" and self:IsA("RemoteEvent") and matchWords(self.Name, ABILITY_WORDS) then
            local now = os.clock()
            if now - (lastRemote[self.Name] or 0) > C.CD_REMOTE_DELAY then
                lastRemote[self.Name] = now
                local args = { ... }
                task.spawn(function()
                    for _ = 1, C.CD_REPEAT do task.wait(0.03); pcall(function() self:FireServer(table.unpack(args, 1, #args)) end) end
                end)
            end
        end
        if guard then return original(self, ...) end
        if C.SilentAim and self == workspace.CurrentCamera and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
            local head = closestHeadSilent()
            if head then return Ray.new(workspace.CurrentCamera.CFrame.Position, (head.Position - workspace.CurrentCamera.CFrame.Position).Unit * 2000) end
        end
        if C.Wallbang and self == workspace then
            local args = { ... }
            local origin, direction, legacy = nil, nil, false
            if method == "Raycast" then origin = args[1]; direction = args[2]
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                local ray = args[1]
                if typeof(ray) == "Ray" then origin = ray.Origin; direction = ray.Direction; legacy = true end
            end
            if origin and direction and typeof(origin) == "Vector3" and typeof(direction) == "Vector3" and direction.Magnitude >= C.MIN_BULLET_LEN then
                local now = os.clock()
                if now - lastWallbang >= C.WALL_COOLDOWN then
                    lastWallbang = now
                    guard = true
                    local okCast, hit = pcall(wallbangCast, origin, direction)
                    guard = false
                    if okCast and hit then
                        if legacy then return hit.Instance, hit.Position, hit.Normal, hit.Material end
                        return hit
                    end
                end
            end
        end
        return original(self, ...)
    end)
    if ok then original = fn end
end
install()

