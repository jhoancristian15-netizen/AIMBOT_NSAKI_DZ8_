local function setInvisible()
        if not Invisible then return end

        local character = player.Character
        if not character then return end

        for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                        part.Transparency = 1
                        part.CanCollide = false
                end

                -- Ocultar accesorios
                if part:IsA("Accessory") or part:IsA("Hat") then
                        if part:FindFirstChild("Handle") then
                                part.Handle.Transparency = 1
                        end
                end

                -- Ocultar ropa
                if part:IsA("Shirt") or part:IsA("Pants") or part:IsA("ShirtGraphic") then
                        part.Transparency = 1
                end
        end

        -- Ocultar humanoid
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
                humanoid.BreakJointsOnDeath = false
        end
end

local function setVisible()
        local character = player.Character
        if not character then return end

        for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                        part.Transparency = 0
                        part.CanCollide = true
                end

                if part:IsA("Accessory") or part:IsA("Hat") then
                        if part:FindFirstChild("Handle") then
                                part.Handle.Transparency = 0
                        end
                end

                if part:IsA("Shirt") or part:IsA("Pants") or part:IsA("ShirtGraphic") then
                        part.Transparency = 0
                end
        end
end

-- Aplicar invisibilidad constantemente
RunService.RenderStepped:Connect(function()
        if Invisible then
                setInvisible()
        end
end)

