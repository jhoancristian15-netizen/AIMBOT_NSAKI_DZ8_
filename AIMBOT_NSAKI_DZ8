--==============================
-- AIMBOT
--==============================

local function getClosestHead()
	camera = workspace.CurrentCamera
	if not camera then return nil end

	local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
	local closest = nil
	local closestDistance = FOVRadius

	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local character = plr.Character
			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local head = character:FindFirstChild("Head")
				if humanoid and head and humanoid.Health > 0 then
					local pos, visible = camera:WorldToViewportPoint(head.Position)
					if visible and pos.Z > 0 then
						local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
						if distance < closestDistance then
							closestDistance = distance
							closest = head
						end
					end
				end
			end
		end
	end

	return closest
end

RunService.RenderStepped:Connect(function()
	if not Aimbot then return end

	camera = workspace.CurrentCamera
	if not camera then return end

	local head = getClosestHead()
	if head then
		camera.CFrame = CFrame.lookAt(camera.CFrame.Position, head.Position)
	end
end)

--==============================
-- X-RAY
--==============================

local xrayParts = {}

local function enableXRay()
	for _,object in ipairs(workspace:GetDescendants()) do
		if object:IsA("BasePart") then
			local character = player.Character
			if not character or not object:IsDescendantOf(character) then
				if xrayParts[object] == nil then
					xrayParts[object] = object.LocalTransparencyModifier
				end
				object.LocalTransparencyModifier = 0.65
			end
		end
	end
end

local function disableXRay()
	for object,value in pairs(xrayParts) do
		if object and object.Parent then
			object.LocalTransparencyModifier = value
		end
	end
	table.clear(xrayParts)
end

