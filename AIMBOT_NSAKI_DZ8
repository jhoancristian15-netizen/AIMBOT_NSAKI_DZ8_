local draggingFOV = false

local function changeFOV(x)
        local left = slider.AbsolutePosition.X
        local width = slider.AbsoluteSize.X
        if width <= 0 then return end

        local percent = math.clamp((x-left)/width, 0, 1)
        FOVRadius = math.floor(FOV_MIN + percent * (FOV_MAX-FOV_MIN))
        updateFOV()
end

slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingFOV = true
                changeFOV(input.Position.X)
        end
end)

UserInputService.InputChanged:Connect(function(input)
        if not draggingFOV then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                changeFOV(input.Position.X)
        end
end)

UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingFOV = false
        end
end)

