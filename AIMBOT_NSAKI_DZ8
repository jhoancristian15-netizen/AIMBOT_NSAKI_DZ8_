local INCLUDE, EXCLUDE
do
        local ok1, v1 = pcall(function() return Enum.RaycastFilterType.Include end)
        INCLUDE = ok1 and v1 or Enum.RaycastFilterType.Whitelist

        local ok2, v2 = pcall(function() return Enum.RaycastFilterType.Exclude end)
        EXCLUDE = ok2 and v2 or Enum.RaycastFilterType.Blacklist
end

local redirected = 0
local hooked = false

local function characters()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                                table.insert(list, plr.Character)
                        end
                end
        end
        return list
end

local function closestHead()
        local cam = workspace.CurrentCamera
        if not cam then return nil end

        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local best, bestDist = nil, math.huge

        for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        local head = plr.Character:FindFirstChild("Head")
                        if hum and head and hum.Health > 0 then
                                local pos, vis = cam:WorldToViewportPoint(head.Position)
                                if vis and pos.Z > 0 then
                                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                        if d < bestDist then
                                                bestDist = d
                                                best = head
                                        end
                                end
                        end
                end
        end

        return best
end

local function params(filterType, list)
        local p = RaycastParams.new()
        p.FilterType = filterType
        p.FilterDescendantsInstances = list
        p.IgnoreWater = true
        return p
end

local function wallbangCast(origin, direction)
        local len = direction.Magnitude
        if len < 0.1 then return nil end

        local unit = direction.Unit
        local chars = characters()
        if #chars == 0 then return nil end

        local hit = workspace:Raycast(origin, direction, params(INCLUDE, chars))
        if not hit or not hit.Instance then return nil end

        local travel = (hit.Position - origin).Magnitude
        if travel <= 0.1 then return hit end

        local world = params(EXCLUDE, chars)
        local cursor = origin
        local used = 0

        for _ = 1, 4 do
                local remaining = travel - used
                if remaining <= 0.05 then break end

                local wall = workspace:Raycast(cursor, unit * remaining, world)
                if not wall then break end

                local probeList = table.clone(chars)
                table.insert(probeList, wall.Instance)
                local probe = workspace:Raycast(
                        wall.Position + unit * 0.02,
                        unit * (MAX_WALL + 1),
                        params(EXCLUDE, probeList)
                )

                if not probe then return nil end

                local thickness = (probe.Position - wall.Position).Magnitude
                if thickness > MAX_WALL then return nil end

                cursor = probe.Position + unit * 0.02
                used = (cursor - origin).Magnitude
        end

        return hit
end

local guard = false
local original

local function install()
        if original then return end
        if not hookmetamethod then
                print("[NSAKI] no hay hookmetamethod")
                return
        end

        local ok, fn = pcall(hookmetamethod, game, "__namecall", function(self, ...)
                local method = getnamecallmethod()

                if guard then
                        return original(self, ...)
                end

                -- REDIRIGIR BALAS
                if SilentAim and self == workspace.CurrentCamera then
                        if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
                                local head = closestHead()
                                if head then
                                        local origin = workspace.CurrentCamera.CFrame.Position
                                        redirected = redirected + 1
                                        return Ray.new(origin, (head.Position - origin).Unit * 2000)
                                end
                        end
                end

                -- TRASPASAR PAREDES
                if Wallbang and self == workspace then
                        local args = { ... }

                        if method == "Raycast" then
                                if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                                        guard = true
                                        local hit = wallbangCast(args[1], args[2])
                                        guard = false
                                        if hit then
                                                redirected = redirected + 1
                                                return hit
                                        end
                                end

                        elseif method == "FindPartOnRay"
                                or method == "FindPartOnRayWithIgnoreList"
                                or method == "FindPartOnRayWithWhitelist" then
                                if typeof(args[1]) == "Ray" then
                                        guard = true
                                        local hit = wallbangCast(args[1].Origin, args[1].Direction)
                                        guard = false
                                        if hit then
                                                redirected = redirected + 1
                                                return hit.Instance, hit.Position, hit.Normal, hit.Material
                                        end
                                end
                        end
                end

                return original(self, ...)
        end)

        if ok then
                original = fn
                hooked = true
                print("[NSAKI] hook instalado correctamente")
        else
                print("[NSAKI] el hook falló:", fn)
        end
end

install()

