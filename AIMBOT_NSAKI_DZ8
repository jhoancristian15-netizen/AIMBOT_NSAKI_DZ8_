local function createSlider(labelText, min, max, initial, onChange)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(1,0,0,48)
        holder.BackgroundTransparency = 1
        holder.ZIndex = 6
        holder.Parent = scroll

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1,0,0,20)
        label.BackgroundTransparency = 1
        label.Text = labelText..tostring(initial)
        label.TextColor3 = Color3.new(1,0.5,0.5)
        label.TextSize = 14
        label.Font = Enum.Font.GothamSemibold
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 6
        label.Parent = holder

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1,0,0,8)
        bar.Position = UDim2.new(0,0,0,32)
        bar.BackgroundColor3 = Color3.fromRGB(60,0,0)
        bar.BorderSizePixel = 0
        bar.ZIndex = 6
        bar.Parent = holder

        local barCorner = Instance.new("UICorner")
        barCorner.CornerRadius = UDim.new(1,0)
        barCorner.Parent = bar

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0.5,0,1,0)
        fill.BackgroundColor3 = Color3.new(1,0,0)
        fill.BorderSizePixel = 0
        fill.ZIndex = 6
        fill.Parent = bar

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1,0)
        fillCorner.Parent = fill

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(18,18)
        knob.AnchorPoint = Vector2.new(0.5,0.5)
        knob.BackgroundColor3 = Color3.new(1,0.2,0.2)
        knob.BorderSizePixel = 0
        knob.ZIndex = 7
        knob.Parent = bar

        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(1,0)
        knobCorner.Parent = knob

        local api = {}
        local dragging = false

        local function paint(percent)
                knob.Position = UDim2.new(percent, 0, 0.5, 0)
                fill.Size = UDim2.new(percent, 0, 1, 0)
        end

        local function apply(x)
                local left = bar.AbsolutePosition.X
                local width = bar.AbsoluteSize.X
                if width <= 0 then return end

                local percent = math.clamp((x-left)/width, 0, 1)
                paint(percent)

                local value = math.floor(min + percent * (max-min) + 0.5)
                label.Text = labelText..tostring(value)
                onChange(value)
        end

        bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        apply(input.Position.X)
                end
        end)

        UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        apply(input.Position.X)
                end
        end)

        UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                end
        end)

        api.set = function(value)
                local percent = math.clamp((value-min)/(max-min), 0, 1)
                paint(percent)
                label.Text = labelText..tostring(math.floor(value + 0.5))
        end

        paint(math.clamp((initial-min)/(max-min), 0, 1))
        onChange(initial)

        return api
end

