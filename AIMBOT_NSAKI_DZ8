local function collectTargets()
        local targets = {}

        for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                        if hum and hrp and hum.Health > 0 then
                                table.insert(targets, plr.Character)
                        end
                end
        end

        if BringNPCs then
                for _, npc in ipairs(npcCache) do
                        if npc.Parent and (npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart")) then
                                table.insert(targets, npc)
                        end
                end
        end

        return targets
end

local function bringTargets()
        local character = player.Character
        if not character then return end

        local myHRP = character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local origin = myHRP.Position
        local look = myHRP.CFrame.LookVector
        local right = myHRP.CFrame.RightVector
        local basePos = origin + look * BRING_OFFSET

        local placed = 0

        for _, target in ipairs(collectTargets()) do
                local hrp = target.PrimaryPart or target:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - origin).Magnitude <= BRING_DISTANCE then
                        local col = (placed % 3) - 1
                        local row = math.floor(placed / 3)

                        local pos = basePos + right * (col * BRING_SPACING) - look * (row * BRING_SPACING)
                        pos = Vector3.new(pos.X, origin.Y + 2, pos.Z)

                        target:PivotTo(CFrame.lookAt(pos, Vector3.new(origin.X, pos.Y, origin.Z)))

                        if AnchorBring then
                                hrp.Anchored = true
                        else
                                hrp.Anchored = false
                        end

                        placed = placed + 1
                end
        end
end

