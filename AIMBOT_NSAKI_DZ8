--==============================
-- ESP RAINBOW
--==============================

local function removeESP(character)
	if not character then return end
	local old = character:FindFirstChild(ESP_NAME)
	if old then old:Destroy() end
end

local function addESP(character)
	if not ESP then return end
	if not character then return end
	if character == player.Character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		humanoid = character:WaitForChild("Humanoid", 5)
	end
	if not humanoid then return end

	removeESP(character)

	local highlight = Instance.new("Highlight")
	highlight.Name = ESP_NAME
	highlight.Adornee = character
	highlight.Enabled = true
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.4
	highlight.OutlineTransparency = 0
	highlight.Parent = character
	
	-- Color inicial
	highlight.FillColor = Color3.fromHSV(0, 1, 1)
	highlight.OutlineColor = Color3.fromHSV(0.5, 1, 1)
	
	return highlight
end

-- Función para actualizar colores rainbow
local function updateRainbowColors()
	if not ESP then return end
	
	local hue = (tick() * 0.2) % 1
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local highlight = plr.Character:FindFirstChild(ESP_NAME)
			if highlight and highlight:IsA("Highlight") then
				highlight.FillColor = Color3.fromHSV(hue, 1, 1)
				highlight.OutlineColor = Color3.fromHSV((hue + 0.5) % 1, 1, 1)
			end
		end
	end
end

local function updateESP()
	for _,plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if ESP then
				if plr.Character then
					addESP(plr.Character)
				end
			else
				removeESP(plr.Character)
			end
		end
	end
end

local function setupESPPlayer(plr)
	if plr == player then return end

	plr.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid", 5)
		task.wait(0.2)
		if ESP then
			addESP(character)
		end
	end)

	if ESP and plr.Character then
		addESP(plr.Character)
	end
end

for _,plr in ipairs(Players:GetPlayers()) do
	setupESPPlayer(plr)
end

Players.PlayerAdded:Connect(setupESPPlayer)

Players.PlayerRemoving:Connect(function(plr)
	removeESP(plr.Character)
end)

-- Loop para actualizar colores rainbow
RunService.RenderStepped:Connect(function()
	updateRainbowColors()
end)

--==============================
-- INVISIBILIDAD
--==============================

local function setInvisible()
	if not Invisible then return end
	
	local character = player.Character
	if not character then return end
	
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Transparency = 1
			part.CanCollide = false
		end
		
		-- Ocultar accesorios
		if part:IsA("Accessory") or part:IsA("Hat") then
			part.Handle.Transparency = 1
		end
		
		-- Ocultar ropa
		if part:IsA("Shirt") or part:IsA("Pants") or part:IsA("ShirtGraphic") then
			part.Transparency = 1
		end
	end
	
	-- Ocultar humanoid
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = false
	end
end

local function setVisible()
	local character = player.Character
	if not character then return end
	
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Transparency = 0
			part.CanCollide = true
		end
		
		if part:IsA("Accessory") or part:IsA("Hat") then
			part.Handle.Transparency = 0
		end
		
		if part:IsA("Shirt") or part:IsA("Pants") or part:IsA("ShirtGraphic") then
			part.Transparency = 0
		end
	end
end

-- Aplicar invisibilidad constantemente
RunService.RenderStepped:Connect(function()
	if Invisible then
		setInvisible()
	end
end)

