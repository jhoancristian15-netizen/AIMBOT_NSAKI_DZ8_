--==============================

local function destroyObstacles()
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local origin = root.Position

        for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Anchored and obj.Name ~= "HumanoidRootPart" then
                        if not obj:IsA("SpawnLocation") then
                                local parentModel = obj:FindFirstAncestorOfClass("Model")
                                local isCharacter = parentModel and parentModel:FindFirstChildOfClass("Humanoid")

                                if not isCharacter and (obj.Position - origin).Magnitude <= DESTROY_RADIUS then
                                        local s = obj.Size
                                        local isFloor = (s.Y <= s.X and s.Y <= s.Z)

                                        if not isFloor then
                                                pcall(function()
                                                        obj:Destroy()
                                                end)
                                        end
                                end
                        end
                end
        end
end

task.spawn(function()
        while true do
                if DestroyWalls then
                        destroyObstacles()
                        task.wait(0.4)
                else
                        task.wait(0.1)
                end
        end
end)

