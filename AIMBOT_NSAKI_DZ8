local function makeDraggable(object, handle)
    local dragging, moved = false, false
    local startMouse, startPos = nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; moved = false
            local abs = object.AbsolutePosition
            object.Position = UDim2.fromOffset(abs.X, abs.Y)
            startMouse = input.Position; startPos = object.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - startMouse
        if delta.Magnitude > 4 then moved = true end
        local viewport = workspace.CurrentCamera.ViewportSize
        local maxX = math.max(0, viewport.X - object.AbsoluteSize.X)
        local maxY = math.max(0, viewport.Y - object.AbsoluteSize.Y)
        object.Position = UDim2.fromOffset(math.clamp(startPos.X.Offset + delta.X, 0, maxX), math.clamp(startPos.Y.Offset + delta.Y, 0, maxY))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    return function() if moved then moved = false; return true end; return false end
end
