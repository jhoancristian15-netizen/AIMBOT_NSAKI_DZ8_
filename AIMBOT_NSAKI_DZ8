        xrayButton.Text = XRay and "👻 X-Ray: ON" or "👻 X-Ray: OFF"
        if XRay then
                enableXRay()
        else
                disableXRay()
        end
end)

godButton.Activated:Connect(function()
        GodMode = not GodMode
        godButton.Text = GodMode and "🛡️ Modo Dios: ON" or "🛡️ Modo Dios: OFF"

        local hum = godHumanoid()
        if not GodMode then
                if hum then
                        hum.MaxHealth = savedMaxHealth or 100
                        hum.Health = hum.MaxHealth
                end
                savedMaxHealth = nil
        end
end)

destroyButton.Activated:Connect(function()
        DestroyWalls = not DestroyWalls
        destroyButton.Text = DestroyWalls and "💥 Destruir Obstáculos: ON" or "💥 Destruir Obstáculos: OFF"

        if DestroyWalls then
                destroyObstacles()
        end
end)

killButton.Activated:Connect(function()
        killTargets()
end)

bringButton.Activated:Connect(function()
        BringAll = not BringAll
        bringButton.Text = BringAll and "🧲 Traer Enemigos: ON" or "🧲 Traer Enemigos: OFF"

        if BringAll then
                bringTargets()
        else
                -- Soltar el anclaje al apagar
                if AnchorBring then
                        for _, plr in ipairs(Players:GetPlayers()) do
                                if plr ~= player and plr.Character then
                                        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                                        if hrp then hrp.Anchored = false end
                                end
                        end
                end
        end
end)

npcButton.Activated:Connect(function()
        BringNPCs = not BringNPCs
        npcButton.Text = BringNPCs and "🤖 Incluir NPCs: ON" or "🤖 Incluir NPCs: OFF"
        npcCache = scanNPCs()
end)

anchorButton.Activated:Connect(function()
        AnchorBring = not AnchorBring
        anchorButton.Text = AnchorBring and "🔒 Anclar Traídos: ON" or "🔒 Anclar Traídos: OFF"

        if not AnchorBring then
                for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= player and plr.Character then
                                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then hrp.Anchored = false end
                        end
                end
        end
end)

